# The tunnel hands every hostname to Caddy over plain HTTP; Cloudflare does the HTTPS.
# The *.localhost names are for testing from the PC through an SSH port forward (see README).
{
	auto_https off
	admin off
}

# One game: its API, its live tables and its web app. {args[0]} is the compose service name.
(game) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {args[0]}:3000
	}

	# The web app talks to Colyseus at /live; core-api serves those routes at its root.
	handle_path /live/* {
		reverse_proxy {args[0]}:3000
	}

	handle {
		root * /srv/{args[0]}

		# Vite fingerprints everything under /assets, so it can be cached for good.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# Room links like /r/abc123 are app routes: serve the app and let it route.
		try_files {path} /index.html
		file_server
	}
}

http://jigsaw.timnox.dev, http://jigsaw.localhost {
	import game felt
}

http://scribble.timnox.dev, http://scribble.localhost {
	import game scribble
}

http://telephone.timnox.dev, http://telephone.localhost {
	import game telephone
}

http://wild.timnox.dev, http://wild.localhost {
	import game wild
}

http://bluff.timnox.dev, http://bluff.localhost {
	import game bluff
}

http://cinemate.timnox.dev, http://cinemate.localhost {
	# Live share: the relay (MediaMTX, on the Pi's own network) answers the small WHIP/WHEP setup
	# requests here. The video itself skips the tunnel: it goes over the MikroTik's UDP 8189 forward.
	handle_path /media/* {
		reverse_proxy host.docker.internal:8889 {
			# The relay's redirects and WHEP session addresses start at its root: put /media back.
			header_down Location ^/ /media/
		}
	}

	import game cinemate
}

# Здам: a static app (the game snippet's /live route is simply unused) plus its sync API at /api.
http://zdam.timnox.dev, http://zdam.localhost {
	import game zdam
}

# The catalogue page. Mounted from the repo, so a change to it needs no rebuild.
http://library.timnox.dev, http://library.localhost {
	encode zstd gzip
	header Cache-Control "no-cache"
	root * /srv/library
	file_server
}

# Anything else (a hostname the tunnel shouldn't be sending).
http:// {
	respond "Not found" 404
}
